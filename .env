# Copy this file to .env and replace the example values.
# Do not commit .env or put real credentials in this file.

# Runtime mode: sky_and_sea, aircraft-local, aircraft-cloud,
# vessels-local, vessels-cloud, or demo
SSA_MODE=sky_and_sea

# Monitoring location
SSA_LAT=0.0000
SSA_LON=0.0000
SSA_AIRCRAFT_RADIUS_MI=25
SSA_VESSEL_RADIUS_MI=3
SSA_POLL_INTERVAL=60
SSA_SUPPRESS_MINUTES=1440

# Aircraft provider: local, adsblol, airplaneslive, adsbfi, adsbone,
# opensky, or adsbx_rapidapi
SSA_AIRCRAFT_PROVIDER=local
SSA_ADSB_URL=http://127.0.0.1:8080/data/aircraft.json
SSA_AIS_URL=

# OpenSky (only needed when SSA_AIRCRAFT_PROVIDER=opensky)
SSA_OPENSKY_BASE=https://opensky-network.org/api
SSA_OPENSKY_CLIENT_ID=
SSA_OPENSKY_CLIENT_SECRET=
SSA_OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
SSA_OPENSKY_DAILY_CREDITS=4000
SSA_OPENSKY_CREDITS_PER_REQUEST=1

# ADS-B Exchange via RapidAPI (only needed for adsbx_rapidapi)
ADSBX_API_KEY=
ADSBX_RAPIDAPI_HOST=adsbexchange-com1.p.rapidapi.com
ADSBX_RAPIDAPI_URL_TEMPLATE=https://adsbexchange-com1.p.rapidapi.com/v2/lat/{lat}/{lon}/{radius_km}

# AIS Hub (only needed for vessels-cloud)
AISHUB_API_KEY=
AISHUB_URL=https://data.aishub.net/ws.php

# Meshtastic direct TCP delivery
SSA_USE_DIRECT_CHANNEL=true
SSA_MESHTASTIC_GATEWAY=127.0.0.1
SSA_MESHTASTIC_GATEWAY_2=127.0.0.1
SSA_MESHTASTIC_CHANNEL=2
SSA_MESHTASTIC_PORT=4403

# MQTT fallback (set SSA_USE_DIRECT_CHANNEL=false to use it)
SSA_MQTT_HOST=
SSA_MQTT_PORT=1883
SSA_MQTT_TOPIC=sky-and-sea-alert/events
SSA_MQTT_USERNAME=
SSA_MQTT_PASSWORD=
SSA_MQTT_TLS=false
SSA_MQTT_ALLOW_IN_MESHMONITOR=false

# Optional API logs
SSA_API_LOGGING=false
# SSA_API_LOG_FILE=SkyandSeaApi.log
# SSA_API_RESPONSE_LOG_FILE=SkyandSeaApiResponses.log
